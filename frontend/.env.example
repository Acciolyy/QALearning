# QALearning - Frontend Environment Variables (Next.js)
# (Copie para .env.local para customizar as origens se necessário)

# URL base da API REST do backend Django
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Origem autorizada dos mini-sites para comunicação cross-origin postMessage (ADR-0008)
NEXT_PUBLIC_MINI_SITES_ORIGIN=http://127.0.0.1:8000
